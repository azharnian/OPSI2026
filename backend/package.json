{
  "name": "opsi2026-air-backend",
  "version": "1.0.0",
  "description": "Simple Express backend for recording air sensor data from ESP32.",
  "main": "src/server.js",
  "scripts": {
    "dev:bun": "bun --watch src/server.js",
    "start:bun": "bun src/server.js",
    "worker": "python3 workers/simulate_sensor.py",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^173.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0"
  }
}
